{
  "name": "@quick-starter/quick-starter-cli",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "type": "module",
  "packageManager": "yarn@4.9.2",
  "scripts": {
    "testnet-remote": "node --loader ts-node/esm --experimental-specifier-resolution=node dist/launcher/testnet-remote.js",
    "standalone": "node --loader ts-node/esm --experimental-specifier-resolution=node dist/launcher/standalone.js",
    "test": "yarn test-e2e",
    "test-e2e": "NODE_OPTIONS=--experimental-vm-modules jest  --detectOpenHandles --forceExit",
    "build": "rm -rf dist && tsc --project tsconfig.build.json",
    "lint": "eslint src"
  },
  "dependencies": {
    "@quick-starter/phq-contract": "workspace:*",
    "@quick-starter/quick-starter-api": "workspace:*",
    "pino": "^10.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/ws": "^8.18.1",
    "allure-commandline": "^2.34.1",
    "allure-jest": "^3.4.2",
    "allure-js-commons": "^3.4.2",
    "eslint": "^9.39.1",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3"
  }
}
