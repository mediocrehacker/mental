{
  "name": "@quick-starter/quick-starter-api",
  "packageManager": "yarn@4.9.2",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "private": true,
  "license": "MIT",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "lint": "eslint src",
    "prepare-local-env": "RUN_STANDALONE='true' NODE_OPTIONS=--experimental-vm-modules jest -t 'prepare local env' --detectOpenHandles --forceExit",
    "test-api": "DEBUG='testcontainers' NODE_OPTIONS=--experimental-vm-modules jest  --detectOpenHandles --forceExit",
    "build": "rm -rf dist && tsc --project tsconfig.build.json"
  },
  "dependencies": {
    "@quick-starter/phq-contract": "workspace:*",
    "pino": "^10.1.0",
    "uuid": "^13.0.0",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "allure-commandline": "^2.34.1",
    "allure-jest": "^3.4.2",
    "allure-js-commons": "^3.4.2",
    "eslint": "^9.39.1",
    "jest": "^30.2.0",
    "typescript": "^5.9.3"
  }
}
